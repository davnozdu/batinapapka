# Copy to .env and fill in. Do NOT commit .env — it contains secrets.

# Brave Search API key — https://brave.com/search/api/
BRAVE_API_KEY=

# Optional. Host path that will be mounted into /videos inside the container.
# Defaults to ./videos (next to the compose file) when unset.
# VIDEO_DIR=/srv/media/videos

# Cron schedule for the recurring run inside the container.
CRON_SCHEDULE=0 3 * * *
