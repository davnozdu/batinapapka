# Copy to .env and fill in. Do NOT commit .env — it contains secrets.

# --- batinapapka (slim renamer) ------------------------------------------

# Brave Search API key — https://brave.com/search/api/
BRAVE_API_KEY=

# Cron schedule for the recurring run inside the container.
# Leave empty (CRON_SCHEDULE=) to make the container a one-shot run.
CRON_SCHEDULE=0 3 * * *

# Pin to a specific image tag for production. Defaults to "latest".
# IMAGE_TAG=1.2.3

# --- batinapapka-cyberdrop (adds cyberdrop-dl + SSH) ---------------------
# Only needed when running batinapapka_cyberdrop-dl.yaml.

# SHELL_USER=youruser
# SHELL_PASSWORD=...
