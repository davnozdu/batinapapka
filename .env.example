# Copy to .env and fill in. Do NOT commit .env — it contains secrets.

# Brave Search API key — https://brave.com/search/api/
BRAVE_API_KEY=

# Host path that will be mounted into /videos.
VIDEO_DIR=/path/to/your/video/files

# Cron schedule for the recurring run inside the container.
CRON_SCHEDULE=0 3 * * *
