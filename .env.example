# Copy to .env and fill in. Do NOT commit .env — it contains secrets.

# --- batinapapka (slim renamer) ------------------------------------------

# Brave Search API key — https://brave.com/search/api/
BRAVE_API_KEY=

# Cron schedule for the recurring run inside the container.
# Leave empty (CRON_SCHEDULE=) to make the container a one-shot run.
CRON_SCHEDULE=0 3 * * *

# --- batinapapka-cyberdrop (adds cyberdrop-dl + SSH) ---------------------
# Only needed when running batinapapka_cyberdrop-dl.yaml.

# SHELL_USER=youruser
# SHELL_PASSWORD=...

# Browser administration (combined image only).
# Defaults to SHELL_USER / SHELL_PASSWORD when left unset.
# ADMIN_USER=admin
# ADMIN_PASSWORD=...
# Local access: http://localhost:8080. For a remote host use an SSH tunnel
# or set ADMIN_BIND_IP to your private LAN/VPN address. Use HTTPS on a proxy.
ADMIN_BIND_IP=127.0.0.1
ADMIN_PORT=8080

# Check PyPI automatically before a download, at most once a day.
# Working versions live in /state; failed updates retain the previous version.
CYBERDROP_AUTO_UPDATE=1
CYBERDROP_UPDATE_INTERVAL=86400
